# Домен приложения (A-запись должна указывать на сервер Dokploy)
DOMAIN=prices.example.com
# Токен входа в /admin
ADMIN_TOKEN=change-me-to-long-random-string
POSTGRES_PASSWORD=change-me
# Ежедневный обход: crontab в часовом поясе TIMEZONE
SCRAPE_CRON=0 3 * * *
TIMEZONE=Europe/Moscow
# Демо-магазины /demo/a|b|c и источники sources/demo-*.yaml; выключите, когда подключите реальные сайты
DEMO_ENABLED=true
# 1 — собрать worker с Chromium для источников с adapter: playwright
WITH_PLAYWRIGHT=0
# Обойти источники сразу при старте worker
RUN_ON_START=false
