# Домен приложения (A-запись должна указывать на сервер Dokploy)
DOMAIN=prices.example.com
# Подпись сессий (openssl rand -hex 32); при смене все выйдут из системы
SECRET_KEY=CHANGE_ME_64_hex_chars
# Первый администратор: создаётся при пустой таблице пользователей.
# Этот же логин/пароль работает как аварийный вход, даже если пароль в базе забыт.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=CHANGE_ME_admin_password
POSTGRES_PASSWORD=change-me
# Ежедневный обход: crontab в часовом поясе TIMEZONE
SCRAPE_CRON=0 3 * * *
TIMEZONE=Europe/Moscow
# Демо-магазины /demo/a|b|c и источники sources/demo-*.yaml; выключите, когда подключите реальные сайты
DEMO_ENABLED=true
# 1 — собрать worker с Chromium для источников с adapter: playwright
WITH_PLAYWRIGHT=0
# Обойти источники сразу при старте worker
RUN_ON_START=false
